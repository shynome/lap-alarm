<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 响铃用 systemExempted 类型：系统允许持有精确闹钟权限的应用使用该类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!-- 精确闹钟 + 响铃振动 + 响铃时亮屏 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".LapApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lap">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lap">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".receiver.ControlReceiver"
            android:exported="false" />

        <!-- 到点入口：由 AlarmManager 的 PendingIntent 触发 -->
        <receiver
            android:name=".receiver.AlarmReceiver"
            android:exported="false" />

        <service
            android:name=".service.RingService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <receiver
            android:name=".receiver.MediaButtonRelay"
            android:exported="false" />

    </application>

</manifest>
